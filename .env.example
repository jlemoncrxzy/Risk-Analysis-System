# ============================================================== DeepSeek
# Первый агент в списке слева сверху.
# API-ключ: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_TOKENS=2000
DISABLE_DEEPSEEK=false

# ============================================================== GigaChat
# Второй агент в списке слева сверху.
# ВАЖНО: GIGACHAT_CREDENTIALS — это Base64(client_id:client_secret),
# а НЕ client_id и не secret по отдельности.
# GIGACHAT_SCOPE — это GIGACHAT_API_PERS (или GIGACHAT_API_CORP), не ключ.
GIGACHAT_CREDENTIALS=your_base64_authorization_key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL=true
GIGACHAT_TIMEOUT=60
DISABLE_GIGACHAT=false

# ============================================================== Алиса AI
# Третий агент в списке слева сверху. Yandex AI Studio / Yandex Cloud.
# ALICE_AI_API_KEY — длинный API-ключ (около 40 символов),
# ALICE_AI_FOLDER_ID — короткий folder id каталога (около 20 символов).
ALICE_AI_API_KEY=your_yandex_ai_studio_api_key
ALICE_AI_FOLDER_ID=your_yandex_cloud_folder_id

# Идентификатор модели Yandex AI Studio для Алисы AI.
# Обычно yandexgpt или yandexgpt-lite. При необходимости задайте полный URI:
# ALICE_AI_MODEL_URI=gpt://your_folder_id/yandexgpt
ALICE_AI_MODEL=yandexgpt
ALICE_AI_MODEL_URI=

# yandex — foundationModels/v1/completion (по умолчанию)
# openai — OpenAI-совместимый /chat/completions
# Для openai укажите ALICE_AI_BASE_URL=https://llm.api.cloud.yandex.net/v1
ALICE_AI_API_STYLE=yandex
ALICE_AI_BASE_URL=https://llm.api.cloud.yandex.net/foundationModels/v1
ALICE_AI_TIMEOUT=60
DISABLE_ALICE_AI=false

# Необязательные алиасы Yandex Cloud:
# YANDEX_API_KEY=your_yandex_api_key
# YANDEX_FOLDER_ID=your_yandex_folder_id

# ==================================================== Локальный fallback
# Используется, если все три облачных агента недоступны.
# Модель уже лежит в models/; повторно скачать:
# .\.venv\Scripts\python.exe scripts\download_local_llm.py
USE_LOCAL_LLM=true
LOCAL_LLM_MODEL=models/Vikhr-Qwen-2.5-1.5B-Instruct
LOCAL_LLM_GGUF=models/Vikhr-Qwen-2.5-1.5B-GGUF/Vikhr-Qwen-2.5-1.5b-Instruct-Q4_K_M.gguf
LOCAL_LLM_THREADS=12
LOCAL_LLM_MAX_TOKENS=180
LOCAL_LLM_CONTEXT_CHARS=600

# ================================================================= Данные
# Папка с исходными CSV/XLSX (по умолчанию data/ в корне проекта).
# DATA_DIR=data
# Опорная дата для расчёта срока годности.
# REFERENCE_DATE=2025-05-05
